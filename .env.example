# Formspree form that receives AI audit submissions. Unset falls back to the
# built-in endpoint; override it in tests so delivery goes to a local stub
# instead of a real inbox.
AI_AUDIT_FORMSPREE_ENDPOINT=https://formspree.io/f/mkoyqdla

# Optional Cloudflare Turnstile keys. The audit currently relies on its
# honeypot and per-IP rate limiting, so these can stay empty until Turnstile is
# actually wired up on the client and the server check is added.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
